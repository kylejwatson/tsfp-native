+        buf = grown;
+        cap = need;
+    }
+    memset(buf, 0, need);
+    for (i = 0; i < NV_ATTRS; i++) {
+        uint32_t afmt = g_arr_format[i], astride = (afmt >> 8) & 0xFFu;
+        uint32_t esize = format_bytes(afmt), n = dsize[i] < esize ? dsize[i] : esize;
