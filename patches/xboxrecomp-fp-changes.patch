 {
     uint32_t holder = voice_field(offset) ? iface - 0x0Cu : iface;
     uint32_t object;
 
+    if (!voice_field(offset))
+        offset += buffer_field_shift();
     if (!guest_readable(holder, 4u))
         return 0u;
     object = HLE_MEM32(holder);
